  "definitions": {
    "gm_pos": "geometric mean of Var_d/Var_U1 over pairs where both are > 0",
    "lcb_ratio": "per scenario sum_q (Q - L+)/Q under the design / the same under U1 (mean over 500 reps, final epoch, rho = 5%), geometric mean over scenarios, cluster bootstrap",
    "relmse_ratio": "per scenario: sum_q Var_d(q)/Q_q^2 / sum_q Var_U1(q)/Q_q^2 over its estimands (classes D, S with Q > 0; the utility's equal-weight objective, Prop. design (b)); Var = analytic sum f^2(1-pi)/pi of the budget-matched designs (seed-averaged); adaptive U6/U6tau = empirical MSE over 500 MC reps (rho = 5% only, as deployed, spend/target reported); summary = geometric mean over scenarios, 95% CI = cluster bootstrap over scenarios with estimands nested (2,000 resamples)",
    "seed_sd": "s.d. over the 3 utility seeds of the per-scenario relmse_ratio, averaged over scenarios",
    "share_exact": "share of (scenario, estimand) pairs where the design retains every hit unit with probability 1 (Var = 0: the total is known exactly)",
    "unit": "test scenario (stream); in-domain = 6 LOSO LP-IoT23 streams at p = 1%; zero-shot = LP-Edge (0.97%), LP-Gotham thinned (1.09%) and natural (15.3%)",
    "worst_pair_ratio": "max over pairs of Var_d/Var_U1 (inflation); worst_vwr = max of sum f^2/pi ratios (Remark bound 1/tau_eff: 5.0001 for tau = 0.2, 2 for tau = 0.5)",
    "worst_rv_ratio": "per scenario max_q Var_d/Q^2 over max_q Var_U1/Q^2 (minimax objective), geometric mean over scenarios"
  },
